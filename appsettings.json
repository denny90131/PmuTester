// ==========================================================================
//  PMU Tester 設定檔
//  - 放在執行檔旁（與 PmuApp.exe 同資料夾）；也可用命令列指定：PmuApp.exe --config D:\path\my.json
//  - 程式內「設定」分頁按「儲存」會覆寫本檔（註解自動重新產生）
//  - 手動修改後，在程式內按「重新載入設定檔」即可套用
//  - 時間單位為毫秒 (Ms) 或秒 (Sec)，以欄位名稱結尾為準
// ==========================================================================
{

  // ---- PMU 連線目標（上方連線列的內容，按「連線」時會自動儲存） ----
  "Connection": {
    "Host": "127.0.0.1",                    // PMU / PDC 的 IP 或主機名稱
    "Port": 4712,                           // TCP 埠號（C37.118 慣用 4712）
    "IdCode": 235,                          // Stream IDCODE（0–65535），須與 PMU CFG-2 一致
    "CommandVersion": null,                 // 指令版本：null = 自動（CFG-2 逾時會在 2011／2005 間切換）；1 = 固定 2005；2 = 固定 2011
    "AutoConnect": false,                   // true = 開啟程式後自動連線；false = 手動按「連線」
    "Description": ""                       // 連線名稱，會顯示在視窗標題與常用連線清單，例如 "變電所A-主PMU"
  },

  // ---- 常用連線（成功連線後自動加入，最多 10 筆，可在上方「常用連線」下拉選單快速切換） ----
  "SavedConnections": [],

  // ---- 逾時設定 ----
  "Timeouts": {
    "ConnectTimeoutMs": 3000,               // TCP 連線逾時
    "NoDataTimeoutMs": 5000,                // 開啟資料流後超過此時間沒收到 Data Frame 視為斷線
    "CfgRequestTimeoutMs": 3000,            // 請求 CFG-2 的逾時
    "CfgRequestRetries": 3                  // CFG-2 逾時後重送次數，全部失敗即斷線
  },

  // ---- 斷線自動重連（指數退避） ----
  "Reconnect": {
    "InitialIntervalMs": 1000,              // 第一次重連前等待
    "BackoffMultiplier": 1.5,               // 每次失敗後等待時間 × 倍率
    "MaxIntervalMs": 5000                   // 等待時間上限
  },

  // ---- 接收緩衝 ----
  "Buffer": {
    "MaxPendingFrames": 1024                // 未派送 Data Frame 暫存上限，滿了丟棄最舊（60 fps 時 1024 ≈ 17 秒）
  },

  // ---- 畫面顯示（修改後立即生效） ----
  "Ui": {
    "WindowTitle": "PMU Tester",            // 視窗標題
    "Theme": "System",                      // 佈景主題：System = 跟隨 Windows；Light = 淺色；Dark = 深色
    "RefreshIntervalMs": 50,                // 畫面更新週期（毫秒，不影響接收速率）
    "DefaultStationIndex": 0,               // 連線後預設選取第幾個站台（從 0 開始）
    "TimeZone": "Local",                    // 時間戳顯示時區：Local = 本機時間；Utc = UTC
    "TimestampFormat": "HH:mm:ss.fff",      // 時間戳格式（.NET 自訂日期格式），例："yyyy-MM-dd HH:mm:ss.ffffff"
    "AngleUnit": "Degree",                  // 相角單位：Degree = 度；Radian = 弧度
    "MagnitudeDecimals": 2,                 // 振幅小數位數
    "AngleDecimals": 2,                     // 相角小數位數
    "FrequencyDecimals": 4,                 // 頻率 / ROCOF 小數位數
    "TrendWindowSeconds": 30                // 趨勢圖顯示最近幾秒（5–600）
  },

  // ---- 告警判斷（修改後立即生效） ----
  "Alarm": {
    "Enabled": true,                        // 是否啟用告警判斷
    "RocofThreshold": 0.5,                  // ROCOF 門檻（Hz/s，取絕對值比較）
    "RocofConsecutivePoints": 3,            // 連續幾個有效點超過門檻才觸發
    "FrequencyHighLimit": 60.5,             // 頻率上限（Hz），超過即告警
    "FrequencyLowLimit": 59.5,              // 頻率下限（Hz），低於即告警
    "DetectGaps": true                      // 偵測掉包與時間倒退（依 CFG-2 的 DATA_RATE 判斷）
  },

  // ---- CSV 錄製 ----
  "Recording": {
    "Directory": "records",                 // 錄製檔資料夾（相對路徑以執行檔資料夾為準）
    "EveryNthFrame": 1,                     // 降頻：每 N 個 Frame 存一筆（1 = 全存；60 fps 設 60 ≈ 每秒一筆）
    "OnlyValid": false,                     // 只錄 IsValid = true 的資料
    "IncludeRectangular": false,            // 相量欄位同時輸出實部 / 虛部
    "UseUtc": true                          // 時間欄位使用 UTC（false = 本機時間）
  },

  // ---- 診斷記錄（C37Comm 內部訊息寫入檔案，下次連線時生效） ----
  "Logging": {
    "Enabled": false,                       // 是否寫入記錄檔
    "MinimumLevel": "Information",          // 最低記錄等級：Trace / Debug / Information / Warning / Error / Critical
    "Directory": "logs",                    // 記錄資料夾（相對路徑以執行檔資料夾為準）
    "FileNamePattern": "pmu_{date}.log",    // 檔名樣板，{date} → yyyyMMdd
    "RetentionDays": 30                     // 超過天數的記錄檔於連線時刪除；0 = 永久保留
  },

  // ---- 【預留】資料庫儲存（目前程式尚未實作寫入，欄位先行保留） ----
  "Database": {
    "Enabled": false,                       // 是否啟用資料庫儲存
    "Provider": "None",                     // None / SqlServer / PostgreSql / TimescaleDb / MySql / Sqlite / InfluxDb
    "ConnectionString": "",                 // 完整連線字串；有填則優先使用，忽略下方個別欄位
    "Server": "localhost",
    "Port": 0,                              // 0 = 該資料庫預設埠
    "DatabaseName": "pmu",                  // Sqlite 時為檔案路徑
    "Username": "",
    "Password": "",                         // 建議改用 PasswordEnvironmentVariable
    "PasswordEnvironmentVariable": "",      // 有填則改從此環境變數讀密碼，例如 "PMU_DB_PASSWORD"
    "IntegratedSecurity": false,            // SQL Server Windows 驗證
    "UseSsl": false,
    "TrustServerCertificate": false,
    "CommandTimeoutSec": 30,
    "MaxPoolSize": 20,
    "Schema": "dbo",                        // PostgreSQL 一般為 "public"
    "TablePrefix": "pmu_",
    "AutoCreateTables": true,
    "InfluxOrganization": "",
    "InfluxBucket": "pmu",
    "InfluxToken": "",
    // ---- 寫入策略 ----
    "Write": {
      "BatchSize": 500,
      "FlushIntervalMs": 1000,
      "StoreEveryNthFrame": 1,
      "MaxQueueSize": 100000,
      "RetryCount": 3,
      "RetryIntervalMs": 2000,
      "StoreOnlyValid": false,
      "StationIdCodes": [],
      "StoreFrequency": true,
      "StoreRocof": true,
      "StorePhasors": true,
      "StoreAnalogs": true,
      "StoreDigitals": true,
      "StoreStatusWord": true,
      "StoreConfigurationFrames": true,
      "StoreConnectionEvents": true,
      "UseUtcTimestamp": true
    },
    // ---- 資料保留 ----
    "Retention": {
      "RawDataDays": 90,
      "EventDays": 365,
      "CleanupIntervalHours": 24
    }
  }
}

