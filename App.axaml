<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PmuApp.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PmuWindowBg" Color="#F3F5F8" />
                    <SolidColorBrush x:Key="PmuTopBarBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PmuCard" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PmuCardBorder" Color="#E1E5EB" />
                    <SolidColorBrush x:Key="PmuRowAlt" Color="#F7F9FB" />
                    <SolidColorBrush x:Key="PmuMuted" Color="#667085" />
                    <SolidColorBrush x:Key="PmuStrong" Color="#101828" />
                    <SolidColorBrush x:Key="PmuGrid" Color="#D0D5DD" />
                    <SolidColorBrush x:Key="PmuOk" Color="#12805C" />
                    <SolidColorBrush x:Key="PmuOkBg" Color="#E3F6EE" />
                    <SolidColorBrush x:Key="PmuWarn" Color="#B54708" />
                    <SolidColorBrush x:Key="PmuWarnBg" Color="#FEF3E2" />
                    <SolidColorBrush x:Key="PmuBad" Color="#C01048" />
                    <SolidColorBrush x:Key="PmuBadBg" Color="#FDE8EE" />
                    <SolidColorBrush x:Key="PmuIdle" Color="#667085" />
                    <SolidColorBrush x:Key="PmuIdleBg" Color="#EEF0F3" />
                    <SolidColorBrush x:Key="PmuFreqLine" Color="#2A78D6" />
                    <SolidColorBrush x:Key="PmuRocofLine" Color="#9A5BD1" />
                    <SolidColorBrush x:Key="PmuLedOn" Color="#17B26A" />
                    <SolidColorBrush x:Key="PmuLedOff" Color="#D0D5DD" />
                    <SolidColorBrush x:Key="PmuCode" Color="#F2F4F7" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PmuWindowBg" Color="#16181D" />
                    <SolidColorBrush x:Key="PmuTopBarBg" Color="#1E2128" />
                    <SolidColorBrush x:Key="PmuCard" Color="#1F232B" />
                    <SolidColorBrush x:Key="PmuCardBorder" Color="#2F3540" />
                    <SolidColorBrush x:Key="PmuRowAlt" Color="#242933" />
                    <SolidColorBrush x:Key="PmuMuted" Color="#98A2B3" />
                    <SolidColorBrush x:Key="PmuStrong" Color="#F2F4F7" />
                    <SolidColorBrush x:Key="PmuGrid" Color="#3A414E" />
                    <SolidColorBrush x:Key="PmuOk" Color="#47CD89" />
                    <SolidColorBrush x:Key="PmuOkBg" Color="#123B2A" />
                    <SolidColorBrush x:Key="PmuWarn" Color="#FDB022" />
                    <SolidColorBrush x:Key="PmuWarnBg" Color="#3D2C0E" />
                    <SolidColorBrush x:Key="PmuBad" Color="#F97096" />
                    <SolidColorBrush x:Key="PmuBadBg" Color="#43172A" />
                    <SolidColorBrush x:Key="PmuIdle" Color="#98A2B3" />
                    <SolidColorBrush x:Key="PmuIdleBg" Color="#2A2F38" />
                    <SolidColorBrush x:Key="PmuFreqLine" Color="#5EA3F2" />
                    <SolidColorBrush x:Key="PmuRocofLine" Color="#C29BF0" />
                    <SolidColorBrush x:Key="PmuLedOn" Color="#47CD89" />
                    <SolidColorBrush x:Key="PmuLedOff" Color="#3A414E" />
                    <SolidColorBrush x:Key="PmuCode" Color="#191C22" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="PmuMono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- 卡片 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource PmuCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PmuCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PmuStrong}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource PmuMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource PmuMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>
        <Style Selector="TextBlock.kpi">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PmuStrong}" />
        </Style>
        <Style Selector="TextBlock.kpiUnit">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PmuMuted}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="4,0,0,6" />
        </Style>
        <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource PmuMono}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.err">
            <Setter Property="Foreground" Value="{DynamicResource PmuBad}" />
        </Style>

        <!-- 狀態膠囊 -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="{DynamicResource PmuIdleBg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.pill > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PmuIdle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.pill.ok"><Setter Property="Background" Value="{DynamicResource PmuOkBg}" /></Style>
        <Style Selector="Border.pill.ok > TextBlock"><Setter Property="Foreground" Value="{DynamicResource PmuOk}" /></Style>
        <Style Selector="Border.pill.warn"><Setter Property="Background" Value="{DynamicResource PmuWarnBg}" /></Style>
        <Style Selector="Border.pill.warn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource PmuWarn}" /></Style>
        <Style Selector="Border.pill.bad"><Setter Property="Background" Value="{DynamicResource PmuBadBg}" /></Style>
        <Style Selector="Border.pill.bad > TextBlock"><Setter Property="Foreground" Value="{DynamicResource PmuBad}" /></Style>

        <!-- 狀態燈 -->
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{DynamicResource PmuIdle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.dot.ok"><Setter Property="Fill" Value="{DynamicResource PmuOk}" /></Style>
        <Style Selector="Ellipse.dot.warn"><Setter Property="Fill" Value="{DynamicResource PmuWarn}" /></Style>
        <Style Selector="Ellipse.dot.bad"><Setter Property="Fill" Value="{DynamicResource PmuBad}" /></Style>

        <!-- KPI 卡片在告警時變色 -->
        <Style Selector="Border.card.alarm">
            <Setter Property="Background" Value="{DynamicResource PmuBadBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PmuBad}" />
        </Style>
        <Style Selector="Border.card.alarm TextBlock.kpi">
            <Setter Property="Foreground" Value="{DynamicResource PmuBad}" />
        </Style>

        <!-- 統計數值：非 0 錯誤計數 -->
        <Style Selector="TextBlock.statValue">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="{StaticResource PmuMono}" />
        </Style>
        <Style Selector="TextBlock.statValue.warn">
            <Setter Property="Foreground" Value="{DynamicResource PmuWarn}" />
        </Style>
        <Style Selector="TextBlock.flagValue.bad"><Setter Property="Foreground" Value="{DynamicResource PmuBad}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="TextBlock.flagValue.notice"><Setter Property="Foreground" Value="{DynamicResource PmuWarn}" /></Style>

        <!-- DI LED -->
        <Style Selector="Border.led">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource PmuLedOff}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.led.on"><Setter Property="Background" Value="{DynamicResource PmuLedOn}" /></Style>
        <Style Selector="Border.led.abnormal"><Setter Property="Background" Value="{DynamicResource PmuBad}" /></Style>
        <Style Selector="Border.diTile">
            <Setter Property="Background" Value="{DynamicResource PmuRowAlt}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Width" Value="210" />
        </Style>
        <Style Selector="Border.diTile.disabled"><Setter Property="Opacity" Value="0.5" /></Style>

        <!-- 事件紀錄等級 -->
        <Style Selector="Border.lvl">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="{DynamicResource PmuIdleBg}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.lvl > TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource PmuIdle}" /></Style>
        <Style Selector="Border.lvl.warn"><Setter Property="Background" Value="{DynamicResource PmuWarnBg}" /></Style>
        <Style Selector="Border.lvl.warn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource PmuWarn}" /></Style>
        <Style Selector="Border.lvl.bad"><Setter Property="Background" Value="{DynamicResource PmuBadBg}" /></Style>
        <Style Selector="Border.lvl.bad > TextBlock"><Setter Property="Foreground" Value="{DynamicResource PmuBad}" /></Style>

        <!-- 設定頁 -->
        <Style Selector="Grid.setRow">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Grid.setRow > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style Selector="TabControl > TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
    </Application.Styles>
</Application>
